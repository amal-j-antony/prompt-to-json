{
  "name": "prompt-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json && node scripts/finish-server-build.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "verify:ui": "node scripts/verify-ui.cjs",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start": "node dist-server/server/index.js",
    "verify:api": "node scripts/verify-api.mjs",
    "verify:auth": "node scripts/verify-auth.cjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.70.0",
    "mongodb": "^7.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19"
  }
}
